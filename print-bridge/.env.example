# SiteHubMan Print Bridge - Configuration Template

# ⚠️ WARNING: DO NOT COMMIT THIS FILE OR YOUR SERVICE_ACCOUNT.JSON TO GIT!
# This file contains sensitive credentials.

# 1. Firebase Configuration
# Download your Service Account JSON from Firebase Console:
# Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID=your-project-id
SERVICE_ACCOUNT_PATH=./service-account.json

# 2. Workshop Configuration
# The ID of the branch/workshop this bridge will serve.
# This MUST match the 'branchId' used in your mobile app.
BRANCH_ID=your-workshop-branch-id

# 3. Printer Configuration
# The local IP address of your printer (e.g., 192.168.1.50)
PRINTER_IP=192.168.1.1

# 4. Print Mode
# RAW: Sends data exactly as provided by the job (use for ZPL, ESC/POS, or RAW text).
# IMAGE: (Future feature) Automatically attempts to convert images to a printable format.
PRINT_MODE=RAW

# 5. Optional: Logging Level
# debug: Full details (recommended for setup)
# info: Standard operational logs
# error: Only errors
LOG_LEVEL=debug
